# Copy to .env.local for local work. On Vercel, add the same names under
# Project → Settings → Environment Variables. Never commit real values.

NEXT_PUBLIC_SITE_URL=https://humanx.io

# --- Signing secret (form timing token + admin session). 32+ random chars.
#     Generate: openssl rand -hex 32
APP_SECRET=

# --- Admin panel (/admin)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- New-inquiry notifications. Pick ONE sender:
#  (a) Your own Google Workspace mailbox over SMTP — used whenever SMTP_USER and SMTP_PASSWORD are set.
#      SMTP_PASSWORD is a 16-character Google "app password" for that mailbox, not its login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
#  (b) Brevo transactional API — used only when the SMTP values above are empty.
BREVO_API_KEY=
# "From" address and name. With SMTP this defaults to SMTP_USER; with Brevo it must be a verified sender.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="HumanX Enquiries"
# Comma-separated recipients.
NOTIFY_EMAILS=
# 1 = build the email but do not send it (logs a one-line summary instead).
EMAIL_DRY_RUN=

# --- Cloudflare Turnstile (invisible bot check). Leave both empty to skip the check.
#     Local test keys that always pass: site 1x00000000000000000000BB / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Storage for inquiries + rate limits (Upstash Redis REST; the Vercel Marketplace
#     "Upstash for Redis" integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically).
#     Without these, local dev writes to .data/inquiries.json and production cannot keep inquiries.
KV_REST_API_URL=
KV_REST_API_TOKEN=
